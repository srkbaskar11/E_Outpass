{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Seed Database",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe setup_db.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": { "label": "DB Seed" }
      },
      "problemMatcher": []
    },
    {
      "label": "2. Start Backend (uvicorn)",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": { "label": "Backend" }
      },
      "problemMatcher": [
        {
          "pattern": [{ "regexp": ".", "file": 1, "line": 2, "message": 3 }],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Started reloader process",
            "endsPattern": "Application startup complete"
          }
        }
      ]
    },
    {
      "label": "3. Start Frontend (http.server)",
      "type": "shell",
      "command": "W:\\Apps\\python_idle\\python.exe -m http.server 3000",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": { "label": "Frontend" }
      },
      "problemMatcher": []
    },
    {
      "label": "4. Start Full Stack (Backend + Frontend)",
      "dependsOn": ["2. Start Backend (uvicorn)", "3. Start Frontend (http.server)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Open in Browser",
      "type": "shell",
      "command": "Start-Process http://localhost:3000",
      "group": "test",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Open API Docs",
      "type": "shell",
      "command": "Start-Process http://localhost:8000/docs",
      "group": "test",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
